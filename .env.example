# Copy to .env and fill in. .env is git-ignored; never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# "Today" for pricing/deposit rules. Eval expectations assume 2026-11-19.
MIRA_TODAY=2026-11-19

# Model routing: simple turns -> small model, complex itineraries -> large model.
MIRA_MODEL_SMALL=gemini-3.1-flash-lite
MIRA_MODEL_LARGE=gemini-3-flash-preview
MIRA_MODEL_JUDGE=gemini-2.5-flash
MIRA_MODEL_FALLBACK=gemini-2.5-flash

# Tracing (Arize Phoenix)
MIRA_TRACING=1
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_UI_URL=http://localhost:6006

# Understand messages with rules + a trained intent classifier first, Gemini only when unsure. 0 = always Gemini.
MIRA_LOCAL_NLU=1
